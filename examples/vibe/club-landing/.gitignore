# config.js KHÔNG bị chặn: file chỉ chứa Project URL và khóa công khai (publishable/anon), an toàn nhờ RLS.
# Không bao giờ đặt service_role hoặc secret key vào đó. Dùng cách build nâng cao thì thêm lại dòng config.js.

# Biến môi trường và khóa
.env
.env.*
!.env.example

# Thư mục công cụ
node_modules/
.vercel/
.netlify/
.wrangler/
.DS_Store

# Thư mục build do build-config.mjs tạo ra
dist/
