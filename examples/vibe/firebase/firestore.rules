rules_version = '2';

// Nguyên tắc: mặc định CHẶN hết, chỉ mở đúng thứ cần mở.
// Không bao giờ viết: allow read, write: if true;
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Ghi chú riêng tư: mỗi người chỉ thấy và sửa ghi chú của chính mình.
    match /notes/{noteId} {
      allow read: if isOwner(resource.data.ownerId);

      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.keys().hasOnly(['ownerId', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;

      allow delete: if isOwner(resource.data.ownerId);
    }

    // Bài đăng công khai: ai cũng đọc được, chỉ người đăng được sửa.
    match /public_posts/{postId} {
      allow read: if true;

      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.keys().hasOnly(['ownerId', 'title', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120;

      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // Mọi đường dẫn khác: không có rule nào khớp nghĩa là bị chặn.
  }
}
